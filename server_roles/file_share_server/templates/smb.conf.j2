# {{ ansible_managed | default('Managed by Ansible — server_roles/file_share_server') }}
[global]
   workgroup = {{ file_share_smb_workgroup }}
   server string = {{ file_share_smb_server_string }}
   security = user
   min protocol version = {{ file_share_smb_min_protocol }}
   smb encrypt = {{ file_share_smb_encrypt }}
   map to guest = never
   guest ok = no
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file

{% for share in file_share_shares %}
{% if 'smb' in share.protocols %}
[{{ share.name }}]
   path = {{ share.path }}
   browsable = yes
   guest ok = no
   read only = {{ 'yes' if share.read_only | default(false) else 'no' }}
   valid users = {{ share.smb_valid_users | join(' ') }}
   force user = {{ file_share_owner }}
   force group = {{ file_share_group }}
   create mask = 0640
   directory mask = 0750
{% endif %}
{% endfor %}
