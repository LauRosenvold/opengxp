# {{ ansible_managed | default('Managed by Ansible — server_roles/etcd_cluster') }}
# A role-owned unit, not a distro-packaged one — there is no consistent
# official etcd RPM across RHEL/AlmaLinux versions (see
# defaults/main.yml's etcd_version comment), so this role owns the
# whole lifecycle including the systemd unit itself.
[Unit]
Description=etcd distributed key-value store
Documentation=https://etcd.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User={{ etcd_user }}
Group={{ etcd_group }}
ExecStart={{ etcd_install_dir }}/etcd --config-file={{ etcd_config_dir }}/etcd.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
