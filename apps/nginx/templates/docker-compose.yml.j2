# {{ ansible_managed | default('Managed by Ansible — apps/nginx') }}

services:
  nginx:
    image: {{ nginx_image }}
    ports:
      - "{{ nginx_https_port }}:8443"
      - "{{ nginx_http_port }}:8080"
    volumes:
      - {{ nginx_app_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ nginx_tls_dir }}:/etc/nginx/tls:ro
      - {{ nginx_content_dir }}:/usr/share/nginx/content:ro
      - {{ nginx_log_dir }}:/var/log/nginx:rw
    healthcheck:
      test: ["CMD", "wget", "--no-check-certificate", "-qO-", "https://localhost:8443/healthz"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 15s
    restart: unless-stopped

networks:
  default:
    name: nginx
