# {{ ansible_managed | default('Managed by Ansible — apps/netbox') }}
# Consumed two ways: Docker Compose reads this file automatically (it's
# named .env, in the same directory as docker-compose.yml) for its own
# ${...} substitution, AND tasks/compose.yml references it explicitly via
# `env_file:` on each service so these become real container environment
# variables. Mode 0600 (see tasks/compose.yml) — this file holds every
# secret this stack has.
#
# Variable names below match netbox-docker's conventions as of the image
# tag pinned in defaults/main.yml — NetBox's own env var names have
# changed across major versions before; verify against
# https://github.com/netbox-community/netbox-docker's docs for whatever
# tag you actually bump to.

# --- Core ---------------------------------------------------------------
SECRET_KEY={{ netbox_secret_key }}
ALLOWED_HOST={{ netbox_allowed_hosts | join(' ') }}

# --- Database -------------------------------------------------------------
DB_HOST={{ 'postgres' if not netbox_external_database_enabled else (hostvars[netbox_database_host].ansible_host | default(netbox_database_host)) }}
DB_NAME={{ netbox_database_name }}
DB_USER={{ netbox_database_user }}
DB_PASSWORD={{ netbox_database_password }}
DB_PORT={{ netbox_database_port }}

# --- Redis: task queue ------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ netbox_redis_password }}
REDIS_DATABASE=0
REDIS_SSL=false

# --- Redis: cache -------------------------------------------------------------
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD={{ netbox_redis_cache_password }}
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false

# --- Superuser (created on first boot only — changing this later does NOT
# reset the password of an already-created account) ---------------------
SKIP_SUPERUSER=false
SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_password }}

{% if not netbox_external_database_enabled %}
# --- Bundled postgres container (lab/evaluation fallback only) -----------
POSTGRES_USER={{ netbox_database_user }}
POSTGRES_PASSWORD={{ netbox_database_password }}
POSTGRES_DB={{ netbox_database_name }}
{% endif %}
